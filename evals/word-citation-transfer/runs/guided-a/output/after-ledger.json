  "paragraphs": [
    {
      "location": "word/document.xml paragraph 1",
      "text": "Collection record methods"
    },
    {
      "location": "word/document.xml paragraph 2",
      "text": "This constructed document contains fictional references for a citation audit. It is not a research submission."
    },
    {
      "location": "word/document.xml paragraph 3",
      "text": "The catalogue contains two registers (Ellis, 2020a)."
    },
    {
      "location": "word/document.xml paragraph 4",
      "text": "The second register is documented separately (Ellis, 2020b)."
    },
    {
      "location": "word/document.xml paragraph 5",
      "text": "An explanatory source appears only in the attached note."
    },
    {
      "location": "word/document.xml paragraph 6",
      "text": "Recorded items → Organized catalogue → Comparison"
    },
    {
      "location": "word/document.xml paragraph 7",
      "text": "Figure 1  Overview of the record process, based on (Kline, 2022)."
    },
    {
      "location": "word/document.xml paragraph 8",
      "text": "The process is summarized in Figure 1."
    },
    {
      "location": "word/document.xml paragraph 9",
      "text": "References"
    },
    {
      "location": "word/document.xml paragraph 10",
      "text": "Ellis, M. (2020a). Archive Register Methods. Example Press.\nEllis, M. (2020b). Museum Register Methods. Example Press.\nPaz, L. (2018). Oral Catalogue Notes. Example Press.\nKline, E. (2022). Collection Diagrams. Example Press."
    },
    {
      "location": "word/document.xml paragraph 11",
      "text": "Further reading"
    },
    {
      "location": "word/document.xml paragraph 12",
      "text": "Huang, R. (2017). Further Curatorial Reading. Example Press."
    },
    {
      "location": "word/footnotes.xml footnote -1 paragraph 1",
      "text": ""
    },
    {
      "location": "word/footnotes.xml footnote 0 paragraph 2",
      "text": ""
    },
    {
      "location": "word/footnotes.xml footnote 1 paragraph 3",
      "text": " Note-specific context follows (Paz, 2018)."
    }
  ],
