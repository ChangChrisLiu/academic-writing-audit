    "paragraphs": [
      {
        "part": "word/document.xml",
        "paragraph": 1,
        "style": "Title",
        "text": "Instrument record methods"
      },
      {
        "part": "word/document.xml",
        "paragraph": 2,
        "style": null,
        "text": "This constructed document contains fictional references for a citation audit. It is not a research submission."
      },
      {
        "part": "word/document.xml",
        "paragraph": 3,
        "style": null,
        "text": "The alpha calibration protocol is recorded in (Vale, 2024b)."
      },
      {
        "part": "word/document.xml",
        "paragraph": 4,
        "style": null,
        "text": "The beta calibration protocol has a separate record (Vale, 2024)."
      },
      {
        "part": "word/document.xml",
        "paragraph": 5,
        "style": null,
        "text": "An explanatory source appears only in the attached note."
      },
      {
        "part": "word/document.xml",
        "paragraph": 6,
        "style": null,
        "text": "Recorded items \u2192 Organized catalogue \u2192 Comparison"
      },
      {
        "part": "word/document.xml",
        "paragraph": 7,
        "style": "Caption",
        "text": "Figure 1  Overview of the record process, based on (Imani, 2021)."
      },
      {
        "part": "word/document.xml",
        "paragraph": 8,
        "style": null,
        "text": "The process is summarized in Figure 1."
      },
      {
        "part": "word/document.xml",
        "paragraph": 9,
        "style": "Heading1",
        "text": "References"
      },
      {
        "part": "word/document.xml",
        "paragraph": 10,
        "style": null,
        "text": "Vale, T. (2024a). Alpha Sensor Calibration. Example Press.\nVale, T. (2024b). Beta Sensor Calibration. Example Press.\nNg, R. (2022). Quiet Instrument Records. Example Press.\nImani, A. (2021). Diagram Conventions. Example Press.\nMarin, L. (2020). Spare Workshop Notes. Example Press."
      },
      {
        "part": "word/document.xml",
        "paragraph": 11,
        "style": "Heading1",
        "text": "Further reading"
      },
      {
        "part": "word/document.xml",
        "paragraph": 12,
        "style": null,
        "text": "Sato, M. (2019). Further Instrument Reading. Example Press."
      },
      {
        "part": "word/footnotes.xml",
        "paragraph": 1,
        "style": null,
        "text": ""
      },
      {
        "part": "word/footnotes.xml",
        "paragraph": 2,
        "style": null,
        "text": ""
      },
      {
        "part": "word/footnotes.xml",
        "paragraph": 3,
        "style": null,
        "text": " Note-specific context follows (Ng, 2022)."
      }
    ],
